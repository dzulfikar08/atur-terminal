#!/bin/sh
set -eu
: "${ATUR_TERM_ZIG:?Set ATUR_TERM_ZIG to the real Zig executable}"

# The pinned native VT build otherwise specializes code to the build host CPU.
if [ "${1:-}" = build ]; then
    for argument in "$@"; do
        if [ "$argument" = -Demit-lib-vt=true ]; then
            exec "$ATUR_TERM_ZIG" "$@" -Dcpu=baseline
        fi
    done
fi
exec "$ATUR_TERM_ZIG" "$@"
